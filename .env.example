# Configuration optionnelle — voir docs/SUPABASE.md
# Sans ces valeurs, l'app reste 100 % locale (pas de connexion Google).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Tuiles de carte (optionnel). OpenStreetMap ne délivre aucune clé : par défaut la
# carte utilise les tuiles CARTO, sans clé. Pour passer chez un fournisseur qui en
# demande une (MapTiler, Thunderforest, Stadia…), collez son URL complète ci-dessous.
# Exemple MapTiler : https://api.maptiler.com/maps/streets-v2-dark/{z}/{x}/{y}.png?key=VOTRE_CLE
VITE_TILE_URL=
